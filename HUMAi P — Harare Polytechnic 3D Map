@charset "utf-8";

html, body { margin: 0px; padding: 0px; height: 100%; background: rgb(11, 14, 18); overflow: hidden; font-family: -apple-system, "Segoe UI", Arial, sans-serif; }

#canvas { position: absolute; top: 0px; left: 0px; width: 100%; height: 100%; display: block; }

#banner { position: absolute; top: 0px; left: 0px; right: 0px; z-index: 10; pointer-events: none; padding: 16px 20px; background: linear-gradient(rgba(8, 10, 14, 0.92), rgba(8, 10, 14, 0)); }

#banner h1 { color: rgb(255, 255, 255); font-size: 19px; margin: 0px 0px 3px; letter-spacing: 0.4px; font-weight: 600; }

#banner span { color: rgb(154, 165, 177); font-size: 11.5px; }

#hint { position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); z-index: 10; color: rgb(207, 214, 221); background: rgba(15, 18, 24, 0.8); padding: 8px 18px; border-radius: 20px; font-size: 12.5px; pointer-events: none; text-align: center; white-space: nowrap; border: 1px solid rgba(255, 255, 255, 0.08); }

#credit { position: absolute; bottom: 14px; right: 16px; z-index: 10; color: rgb(107, 114, 128); font-size: 10px; font-family: monospace; pointer-events: none; text-align: right; }

.btn { background: rgba(255, 255, 255, 0.06); color: rgb(229, 233, 238); border: 1px solid rgba(255, 255, 255, 0.16); border-radius: 6px; padding: 7px 13px; font-size: 12px; cursor: pointer; margin-left: 8px; }

.btn:hover { background: rgba(255, 255, 255, 0.14); }

.btn.active { background: rgba(255, 90, 90, 0.22); border-color: rgba(255, 90, 90, 0.5); }

#controlsRow { position: absolute; top: 16px; right: 16px; z-index: 10; display: flex; }

#loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 20; color: rgb(139, 149, 161); font-size: 13px; font-family: monospace; }

#legend { position: absolute; top: 64px; right: 16px; z-index: 10; background: rgba(15, 18, 24, 0.82); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 8px; padding: 10px 14px; font-size: 11px; color: rgb(207, 214, 221); line-height: 1.9; }

#legend div span.sw { display: inline-block; width: 11px; height: 11px; border-radius: 2px; margin-right: 7px; vertical-align: -1px; }

#gpsPanel { position: fixed; inset: 0px; z-index: 50; background: rgba(5, 7, 10, 0.86); display: flex; align-items: center; justify-content: center; padding: 20px; }

#gpsPanel.hidden { display: none; }

#gpsPanelInner { position: relative; background: rgb(18, 22, 28); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 12px; padding: 24px 22px; max-width: 400px; width: 100%; color: rgb(232, 238, 243); font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }

#gpsPanelInner h2 { margin: 0px 0px 12px; font-size: 19px; }

#gpsPanelInner p { font-size: 14.5px; line-height: 1.55; color: rgb(207, 214, 221); margin: 0px 0px 12px; }

#gpsClose { position: absolute; top: 10px; right: 12px; background: none; border: none; color: rgb(207, 214, 221); font-size: 24px; cursor: pointer; line-height: 1; }

.gpsStep.hidden { display: none; }

.btn.gpsAction { display: block; width: 100%; text-align: center; margin: 6px 0px 4px; padding: 12px 14px; font-size: 14.5px; background: rgb(28, 110, 242); border-color: rgb(28, 110, 242); color: rgb(255, 255, 255); }

.btn.gpsAction:hover { background: rgb(43, 124, 255); }

.gpsMsg { font-size: 13px; color: rgb(159, 230, 168); min-height: 16px; }

.gpsMsg.err { color: rgb(255, 128, 128); }
